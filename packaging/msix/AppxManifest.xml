<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- ProcessorArchitecture is set by the packaging workflow, which builds a
       separate package per architecture (x64 and x86) and submits both. The
       Store then serves each customer the right one automatically. -->
  <Identity
    Name="__IDENTITY_NAME__"
    Publisher="__PUBLISHER__"
    Version="1.0.0.0"
    ProcessorArchitecture="__ARCH__" />

  <Properties>
    <DisplayName>gsic</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Compress images with 2D Gaussian splatting. Small files, good quality.</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 1809 is the oldest release with the MSIX support
         and the OpenGL driver behaviour this application relies on. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="gsic" Executable="gsic-gui.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="gsic"
        Description="Compress images with 2D Gaussian splatting. Small files, good quality."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Lets Windows open .gsi files with gsic, and show them with our icon. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="gsi">
            <uap:SupportedFileTypes>
              <uap:FileType>.gsi</uap:FileType>
            </uap:SupportedFileTypes>
            <uap:DisplayName>Gaussian splat image</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- The application only reads the images a user picks and writes the
         result beside them. It makes no network connections at all. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
