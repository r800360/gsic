{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x64 Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x86-release",
      "displayName": "Windows x86 (32-bit) Release",
      "inherits": "windows-base",
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x86-windows-static"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-profile",
      "displayName": "Windows x64 Release + Tracy",
      "inherits": "windows-release",
      "cacheVariables": {
        "GSIC_ENABLE_TRACY": "ON",
        "VCPKG_MANIFEST_FEATURES": "tracy"
      }
    },
    {
      "name": "windows-asan",
      "displayName": "Windows x64 AddressSanitizer",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "GSIC_ENABLE_GPU": "OFF",
        "CMAKE_CXX_FLAGS": "/DWIN32 /D_WINDOWS /EHsc /fsanitize=address",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-x86-release",
      "displayName": "Linux x86 (32-bit) Release",
      "inherits": "linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x86-linux",
        "CMAKE_C_FLAGS": "-m32",
        "CMAKE_CXX_FLAGS": "-m32"
      }
    },
    {
      "name": "macos-release",
      "displayName": "macOS Release",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-x86-release", "configurePreset": "windows-x86-release" },
    { "name": "linux-x86-release", "configurePreset": "linux-x86-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-profile", "configurePreset": "windows-profile" },
    { "name": "windows-asan", "configurePreset": "windows-asan" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],
  "testPresets": [
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-x86-release", "configurePreset": "windows-x86-release" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ]
}
