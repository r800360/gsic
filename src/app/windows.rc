#include <winver.h>

// Icon id 1 is what Explorer and the taskbar pick up for the executable.
// Generated by the `logo` build target; see tools/make_logo.cpp.
1 ICON "../../packaging/gsic.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "gsic project"
            VALUE "FileDescription",  "Gaussian Splat Image Compressor"
            VALUE "FileVersion",      "1.0.1"
            VALUE "InternalName",     "gsic-gui"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "gsic-gui.exe"
            VALUE "ProductName",      "gsic"
            VALUE "ProductVersion",   "1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
